PORT=8787
ROBLOX_WEBHOOK_SECRET=replace-me
REFUND_API_KEY=replace-me-too

# Pro action queue. Keep this separate from REFUND_API_KEY because it can mutate action state.
ACTION_API_KEY=replace-with-a-separate-key

# Optional locally or when overriding Railway's automatic volume path.
# On Railway, attaching a Volume automatically provides RAILWAY_VOLUME_MOUNT_PATH,
# and the app stores refunds.jsonl and actions.jsonl there without needing these variables.
REFUND_LOG_PATH=./data/refunds.jsonl
ACTION_LOG_PATH=./data/actions.jsonl
