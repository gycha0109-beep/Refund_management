# Robux Backtrack Pro E2E staging only.
# Never point E2E_BASE_URL at the maintainer production backend.
E2E_BASE_URL=https://YOUR-PRO-STAGING.example.com
E2E_WEBHOOK_SECRET=replace-with-staging-webhook-secret
E2E_ACTION_API_KEY=replace-with-staging-action-key
E2E_CONFIRM=YES

E2E_USER_ID=123456789
E2E_PRODUCT_ID=987654321
E2E_ROBUX_AMOUNT=400
E2E_TIMEOUT_MS=60000
E2E_POLL_MS=1000
